<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тёмная тема без ActionBar: шапку рисуем сами, инсеты обрабатываем вручную
         (на Android 15 при targetSdk 35 edge-to-edge включён принудительно). -->
    <style name="Theme.HrReceiver" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#FF5A6E</item>
        <item name="colorPrimaryVariant">#D94458</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#2BD9A0</item>
        <item name="colorOnSecondary">#06281D</item>
        <item name="android:colorBackground">#0E1116</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
